---
import Layout from '../layouts/Layout.astro'
import LinkedInIcon from '../icons/LinkedIn.astro'
import GithubIcon from '../icons/Github.astro'
import MailIcon from '../icons/Mail.astro'
import Badge from '../components/Badge.astro'
import SocialButton from '../components/SocialButtons.astro'
import Experience from '../components/Experience.astro'
import SectionContainer from '../components/SectionContainer.astro'
import CaseIcon from '../icons/Case.astro'
import CodeIcon from '../icons/Code.astro'
import Projects from '../components/Projects.astro'
import Sobremi from '../components/Sobremi.astro'
import Contacto from '../components/Contact.astro'
import WspIcon from '../icons/Wsp.astro'
import DescargarIcon from '../icons/Descarga.astro'
---

<Layout 
	title="Portfolio of Nicolas - Desarrollador y Progamador Web" 
	description="Let's collaborate in the construction of solutions for all kinds of problems."	
>
	<main class="px-4">
		<SectionContainer class=" py-44 pb-24">
			<img
			class="rounded-full w-12 h-12 mb-4" 
			src="https://i.ibb.co/0CShq1b/Sin-t-tulo.png" 
			alt="Logo Portfolio"/>
			<h1 class=" text-white text-3xl md:text-4xl lg:text-5xl font-bold flex flex-row gap-x-4 pb-5 lg:pb-10">
				<span id="hero-greeting">Hi, I'm Nicolas</span> <a 
								href="https://www.linkedin.com/in/nicolas-angel-robles-b140b92a6/" 
								target="_blank" 
								rel="noopener" 
								class="flex justify-center items-center"><Badge id="hero-badge">Ready to work</Badge>
							</a>
						</h1>
			<h2 class="text-xl lg:text-2xl text-wrap max-w-[700px]">
				<span class="text-white" id="hero-desc-1">Passionate programmer with experience in creating innovative digital solutions.</span>
				<span class=" text-red-200/90" id="hero-desc-2"> This space is a showcase for my work:</span><span class="text-yellow-100/90" id="hero-desc-3"> from web applications to complex projects,
					you will find here a glimpse of my ability to implement creativity in every line of code.</span>
					<span class="opacity-80 text-white/90	" id="hero-desc-4"> Explore my past projects and discover how I can bring value to your digital ideas.</span>
			</h2>
				<nav class="flex gap-4 mt-8 flex-wrap">
					<SocialButton href="https://www.linkedin.com/in/nicolas-angel-robles-b140b92a6/">
						<LinkedInIcon class="size-3 lg:size-6"/>
						LinkedIn
					</SocialButton>
					<SocialButton href="https://github.com/NicoDevGod">
						<GithubIcon class="size-3 lg:size-6"/>
						Github
					</SocialButton>
					<SocialButton href="https://drive.google.com/file/d/1slV72I8ys4wKNg32SVFVX42Y984wO7Wn/view?usp=drive_link">
						<DescargarIcon class="size-3 lg:size-6"/>
						<span id="download-cv">Download CV</span>
					</SocialButton>	
				</nav>
		</SectionContainer>
		<SectionContainer id="experiencia" />
		<SectionContainer>
			<h2 class="text-2xl font-semibold mb-6 flex gap-x-3 items-center">
				<CaseIcon class="size-7" />
				<span id="section-work-experience">Work Experience</span>
			</h2>
			<Experience />	
		</SectionContainer>
		<SectionContainer id="proyects"/>
		<SectionContainer>
			<h2 class="text-2xl font-semibold mb-6 flex gap-x-3 items-center">
				<CodeIcon class="size-7" />
				<span id="section-projects">Projects</span>
			</h2>
			<Projects />
		</SectionContainer>
		<SectionContainer id="sobre-mi"/>
		<SectionContainer>
			<h2 class="text-2xl font-semibold mb-6 flex gap-x-3 items-center">
				<CodeIcon class="size-7" />
				<span id="section-about-me">About Me</span>
			</h2>
			<Sobremi />
		</SectionContainer>
		<SectionContainer id="contacto"/>
		<SectionContainer>
			<h2 class="text-2xl font-semibold mb-6 flex gap-x-3 items-center">
				<MailIcon class="size-7" />
				<span id="section-contact">Contact</span>
			</h2>
			<Contacto />
		</SectionContainer>
	</main>
</Layout>
