---
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? ''
---

<div class="rounded-lg border border-white/10 bg-white/5 p-6 md:p-8">
	<p id="contact-desc" class="text-gray-100 mb-6">
		Have a project in mind or just want to say hi? Send me a message and I'll get back to you as soon as possible.
	</p>

	<form id="contact-form" class="flex flex-col gap-4" novalidate>
		<input type="hidden" name="access_key" value={accessKey} />
		<input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

		<div>
			<label id="contact-name-label" for="contact-name" class="block text-sm font-medium text-gray-200 mb-1">Name</label>
			<input
				id="contact-name"
				name="name"
				type="text"
				required
				class="w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-white placeholder:text-gray-500 outline-none focus:border-yellow-100/60 transition"
			/>
		</div>

		<div>
			<label id="contact-email-label" for="contact-email" class="block text-sm font-medium text-gray-200 mb-1">Email</label>
			<input
				id="contact-email"
				name="email"
				type="email"
				required
				class="w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-white placeholder:text-gray-500 outline-none focus:border-yellow-100/60 transition"
			/>
		</div>

		<div>
			<label id="contact-message-label" for="contact-message" class="block text-sm font-medium text-gray-200 mb-1">Message</label>
			<textarea
				id="contact-message"
				name="message"
				rows="5"
				required
				class="w-full rounded-md border border-white/10 bg-white/5 px-3 py-2 text-white placeholder:text-gray-500 outline-none focus:border-yellow-100/60 transition resize-none"
			></textarea>
		</div>

		<button
			id="contact-submit"
			type="submit"
			class="mt-2 inline-flex items-center justify-center rounded-full border border-white/10 bg-white/5 py-2 px-4 font-medium hover:scale-[1.02] hover:bg-white/10 transition disabled:opacity-50 disabled:pointer-events-none"
		>
			Send message
		</button>

		<p id="contact-success" class="hidden text-green-400 text-sm"></p>
		<p id="contact-error" class="hidden text-red-400 text-sm"></p>
	</form>
</div>

<script>
	const translations = {
		en: {
			sending: 'Sending...',
			send: 'Send message',
			success: "Thanks! Your message has been sent — I'll reply soon.",
			error: 'Something went wrong. Please try again or email me directly.',
			missingKey: 'Contact form is not configured yet.',
		},
		es: {
			sending: 'Enviando...',
			send: 'Enviar mensaje',
			success: '¡Gracias! Tu mensaje fue enviado, te responderé pronto.',
			error: 'Algo salió mal. Intenta de nuevo o escríbeme directamente por correo.',
			missingKey: 'El formulario de contacto aún no está configurado.',
		},
	};

	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
	const successMsg = document.getElementById('contact-success');
	const errorMsg = document.getElementById('contact-error');

	function currentLang() {
		const lang = document.documentElement.lang;
		return lang === 'es' ? 'es' : 'en';
	}

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!form || !submitBtn || !successMsg || !errorMsg) return;

		const t = translations[currentLang()];
		successMsg.classList.add('hidden');
		errorMsg.classList.add('hidden');

		const accessKey = (form.elements.namedItem('access_key') as HTMLInputElement)?.value;
		if (!accessKey) {
			errorMsg.textContent = t.missingKey;
			errorMsg.classList.remove('hidden');
			return;
		}

		submitBtn.disabled = true;
		submitBtn.textContent = t.sending;

		try {
			const formData = new FormData(form);
			const response = await fetch('https://api.web3forms.com/submit', {
				method: 'POST',
				headers: { Accept: 'application/json' },
				body: formData,
			});
			const result = await response.json();

			if (result.success) {
				successMsg.textContent = t.success;
				successMsg.classList.remove('hidden');
				form.reset();
			} else {
				throw new Error(result.message || 'submit failed');
			}
		} catch (err) {
			errorMsg.textContent = t.error;
			errorMsg.classList.remove('hidden');
		} finally {
			submitBtn.disabled = false;
			submitBtn.textContent = t.send;
		}
	});
</script>
